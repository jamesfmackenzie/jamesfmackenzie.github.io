---
layout: none
---
{
  "posts" : [
    {% for post in site.posts %}
    {
      "title": "{{ post.title }}",
      "url": "{{ post.url }}",
      "date": "{{ post.date | date: "%b %-d, %Y" }}",
      "summary": "{{ post.summary | markdownify | strip_newlines | json }}",
      "layout": "{{ post.layout }}",
	  {% if post.layout == "tweet" %}
	  "tweetId": "{{ post.tweetId }}",
	  {% elsif post.layout == "youtube" %}
	  "videoId": "{{ post.videoId }}",
	  {% endif %}
	  {% if post.layout == "tweet" or post.layout == "youtube" %}
	  "stats": {
	    "replies": "{{ post.stats.replies | default: '' }}",
	    "reposts": "{{ post.stats.reposts | default: '' }}",
	    "likes": "{{ post.stats.likes | default: '' }}",
	    "views": "{{ post.stats.views | default: '' }}"
	  },
	  {% endif %}
	  {% assign thumb = post.image | default: post.hero %}
	  {% if thumb %}
	  "image": "{{ thumb }}",
	  {% endif %}
      "overrideUrl": "{{ post.overrideUrl }}"{% if post.tags.size > 0 %},
			"tags": [{% for tag in post.tags %}{ "name": "{{ tag }}", "urlSafeName": "{{ tag | slugify }}"}{% unless forloop.last %}, {% endunless %}{% endfor %}]{% endif %}
    }
    {% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
